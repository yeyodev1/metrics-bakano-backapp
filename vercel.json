{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tumesero-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/florinda-sales-sync",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/meta-metrics-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/video-review-reminders",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/monthly-target-reminders",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/ghl-production-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/publicidad",
      "schedule": "20 14 * * 1"
    },
    {
      "path": "/api/cron/resumen-mensual",
      "schedule": "40 14 1 * *"
    },
    {
      "path": "/api/cron/facturacion-telegram",
      "schedule": "10 14 * * *"
    },
    {
      "path": "/api/cron/produccion-planificacion",
      "schedule": "40 13 * * *"
    },
    {
      "path": "/api/cron/bot-recordatorios",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/bot-reporte",
      "schedule": "20 13 * * 1"
    },
    {
      "path": "/api/cron/insistir-onboarding",
      "schedule": "0 14,17,20,23 * * *"
    },
    {
      "path": "/api/cron/onboarding-sync",
      "schedule": "10,40 * * * *"
    }
  ]
}
