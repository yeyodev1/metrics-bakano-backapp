DB_URI=mongodb://localhost:27017/your-database
PORT=8100
JWT_SECRET=your_secret_key
SLACK_ERROR_WEBHOOK=

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Bakano Ads <noreply@bakano.ec>
# Frontend destination after OAuth callback. Use the frontend URL for each Vercel environment.
APP_URL=https://testing-storybrand-frontend.bakano.ec

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Florinda sales integration (backend only)
FLORINDA_API_BASE_URL=https://florindafloreria.techncore.com
FLORINDA_API_USER=INTEGRACION
FLORINDA_API_PASSWORD=your_password
FLORINDA_SALES_PATH=/api/reportes/detalle-ventas
FLORINDA_SYNC_START_DATE=2025-11-27
CRON_SECRET=your_vercel_cron_secret

# GHL sales booking webhook
GHL_BOOKING_WEBHOOK_SECRET=generate_a_long_random_secret
GHL_SALES_CALENDAR_ID=your_ghl_sales_calendar_id

# Meta OAuth for the Facebook profile invited to client portfolios.
META_APP_ID=
META_APP_SECRET=
# Must be the backend URL and must exactly match an allowed redirect URI in Meta Developers.
META_OAUTH_REDIRECT_URI=https://testing-storybrand-backapp.bakano.ec/api/meta/global/oauth/callback
# Production example: APP_URL=https://metrics.bakano.ec and META_OAUTH_REDIRECT_URI=https://your-production-backend-domain/api/meta/global/oauth/callback
# Optional: dedicated 32+ character secret to encrypt the stored Facebook token. Falls back to JWT_SECRET.
META_TOKEN_ENCRYPTION_KEY=

# Bakano Finanzas server-to-server integration
FINANCE_API_KEY=

# ── Aviso de planificacion lista ──────────────────────────────────────────
# Webhook de GoHighLevel que dispara el WhatsApp con la plantilla aprobada.
# Sin esta variable el correo igual sale, pero el WhatsApp se registra como
# fallido con ese motivo.
GHL_PLANNING_WEBHOOK_URL=

# Opcional. Si se define, el webhook de Resend exige esta cabecera
# (x-webhook-secret) para aceptar eventos de apertura y clic.
RESEND_WEBHOOK_SECRET=
